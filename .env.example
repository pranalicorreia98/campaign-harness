# =============================================================================
# Campaign Harness Configuration
# =============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Nango Cloud (OAuth management for social platforms)
# Get from https://app.nango.dev → Settings → Secret Key
NANGO_SECRET_KEY=your_nango_secret_key

# WhatsApp Business API
# Get from Meta Business Suite → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token

# Google AI / Gemini for campaign image generation
GOOGLE_AI_API_KEY=your_google_ai_api_key

# Public URL where campaign images are served
# Should point to a publicly accessible location for the generated images
CAMPAIGN_IMAGES_PUBLIC_URL=https://your-domain.com/campaign-images
